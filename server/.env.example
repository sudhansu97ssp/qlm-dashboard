# Server Port
PORT=5000
NODE_ENV=development

# AWS EC2 MS SQL Database Credentials
# Provide your EC2 instance Public IP or DNS hostname
MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_DATABASE=QLM_LicenseManager
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERT=true

# QLM Soraco License Manager Web Service Configuration
# Replace with your organization's QLM License Server URL
QLM_SERVICE_URL=https://qlm3.net/demo/qlmLicenseServer/qlmservice.asmx
QLM_ADMIN_ENCRYPTION_KEY={B2967657-CEE5-4C8D-9817-A1734D8A6ED7}
QLM_COMMUNICATION_KEY={3F82C3D1-72A0-4C96-A5DF-0D76F87C5D41}
QLM_VENDOR=Soraco QLM Enterprise
QLM_PRODUCT_ID=1
QLM_MAJOR_VERSION=17
QLM_MINOR_VERSION=0
